<?xml version="1.0" encoding="utf-8"?>
<!-- キャラクリエイト画面：左に見本、右に色を選ぶところ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/title_bg"
    tools:context=".CharaCreateActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- ========== 左：見本 ========== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dotgothic16"
                android:text="@string/chara_title"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <!-- 主人公の見本（足ぶみする） -->
            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@drawable/chara_stage"
                android:contentDescription="@string/chara_title"
                android:padding="12dp"
                android:scaleType="fitCenter" />

            <!-- 向きを変える -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnTurnLeft"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:background="@drawable/rpg_window"
                    android:gravity="center"
                    android:text="◀"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:text="@string/chara_turn"
                    android:textColor="@color/rpg_gray"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnTurnRight"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:background="@drawable/rpg_window"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="@color/white"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========== 右：色を選ぶところ ========== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1.8"
            android:orientation="vertical">

            <!-- タブ：髪・目・服 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabHair"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/chara_tab_hair"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabEye"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/chara_tab_eye"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabCloth"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/chara_tab_cloth"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 色の編集 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@drawable/rpg_window"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:padding="8dp">

                <!-- 四角と色合いの棒 -->
                <com.example.nibrpg.ColorPickerView
                    android:id="@+id/picker"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <!-- 色見本・数字・基本色 -->
                <LinearLayout
                    android:layout_width="160dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/swatch"
                            android:layout_width="40dp"
                            android:layout_height="40dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="#"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <EditText
                            android:id="@+id/edtHex"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:autofillHints=""
                            android:digits="0123456789ABCDEFabcdef"
                            android:hint="@string/chara_hex_hint"
                            android:imeOptions="actionDone|flagNoExtractUi"
                            android:inputType="textCapCharacters|textNoSuggestions"
                            android:maxLength="6"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="0dp"
                            android:singleLine="true"
                            android:textColor="@color/white"
                            android:textColorHint="@color/rpg_gray"
                            android:textSize="16sp"
                            android:typeface="monospace" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtRgb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:typeface="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/chara_presets"
                        android:textColor="@color/rpg_gray"
                        android:textSize="12sp" />

                    <!-- 基本色の丸（Javaで並べる） -->
                    <GridLayout
                        android:id="@+id/gridPresets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:columnCount="4" />
                </LinearLayout>
            </LinearLayout>

            <!-- 下のボタン -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/rpg_window"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/chara_default"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/rpg_window"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="@string/chara_cancel"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnOk"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/nib_button"
                    android:gravity="center"
                    android:paddingHorizontal="28dp"
                    android:text="@string/chara_ok"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
