<?xml version="1.0" encoding="utf-8"?>
<!-- 武器屋・道具屋：左に店の人の話と自分の状態、右に品物の一覧 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shop_weapon_bg"
    android:baselineAligned="false"
    android:orientation="horizontal"
    tools:context=".ShopActivity">

    <!-- 左 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtShopName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#FF000000"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="1"
            android:textColor="@color/rpg_yellow"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- 店の人のセリフ -->
        <TextView
            android:id="@+id/txtTalk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/rpg_window"
            android:lineSpacingExtra="4dp"
            android:minLines="2"
            android:padding="14dp"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <!-- 自分の状態 -->
        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/rpg_window"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnExit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rpg_window"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="@string/shop_exit"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 右：品物の一覧（多いときはスクロール） -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:paddingVertical="16dp"
        android:paddingEnd="16dp"
        tools:ignore="RtlSymmetry">

        <LinearLayout
            android:id="@+id/listGoods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
