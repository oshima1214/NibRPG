<?xml version="1.0" encoding="utf-8"?>
<!-- 事務室の窓口：左に事務員さん、右に備品申込書 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/office_wall"
    tools:context=".ShopActivity">

    <!-- 上の紺の帯（受付の看板） -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/nib_navy"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:text="@string/reception_title"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="40dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- 左：事務員さん -->
        <LinearLayout
            android:layout_width="250dp"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ふきだし -->
            <TextView
                android:id="@+id/txtTalk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bubble"
                android:lineSpacingExtra="3dp"
                android:minLines="3"
                android:padding="10dp"
                android:textColor="#FF222222"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/imgClerk"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@drawable/obj_clerk" />

            <!-- カウンターの台 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:background="@color/counter_top" />

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:background="@color/counter_front" />

            <!-- 所持金のメモ -->
            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/memo"
                android:lineSpacingExtra="2dp"
                android:padding="8dp"
                android:textColor="#FF333333"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnExit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/nib_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="@string/reception_exit"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 右：備品申込書 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="12dp"
            android:layout_weight="1"
            android:background="@drawable/paper"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.3"
                android:text="@string/reception_form"
                android:textColor="@color/nib_navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:background="@color/nib_navy" />

            <!-- 見出しの行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:text="@string/form_col_name"
                    android:textColor="@color/rpg_gray"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:text="@string/form_col_desc"
                    android:textColor="@color/rpg_gray"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/form_col_price"
                    android:textColor="@color/rpg_gray"
                    android:textSize="11sp" />

                <Space
                    android:layout_width="100dp"
                    android:layout_height="1dp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/listGoods"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
