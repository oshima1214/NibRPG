<?xml version="1.0" encoding="utf-8"?>
<!-- マップ画面：左に階の名前と十字ボタン、右にマップ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- 左：階の名前と十字ボタン -->
        <LinearLayout
            android:layout_width="170dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/txtFloor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rpg_window"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 所持金・HP・攻撃力 -->
            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/rpg_window"
                android:lineSpacingExtra="2dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <!-- メニュー（ステータス・持ち物・記録） -->
            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/nib_button"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="@string/btn_menu"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 十字ボタン -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp">

            <TextView
                android:id="@+id/btnUp"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/rpg_window"
                android:gravity="center"
                android:text="▲"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/btnDown"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/rpg_window"
                android:gravity="center"
                android:text="▼"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/btnLeft"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center_vertical|start"
                android:background="@drawable/rpg_window"
                android:gravity="center"
                android:text="◀"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/btnRight"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center_vertical|end"
                android:background="@drawable/rpg_window"
                android:gravity="center"
                android:text="▶"
                android:textColor="@color/white"
                android:textSize="20sp" />

            </FrameLayout>
        </LinearLayout>

        <!-- 右：マップ -->
        <com.example.nibrpg.MapView
            android:id="@+id/mapView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- メッセージウィンドウ（ふだんはかくしておく） -->
    <LinearLayout
        android:id="@+id/msgBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="180dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/rpg_window"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/msgText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/msgButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">
            <!-- ボタンは、メッセージごとにJavaで作る -->
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
