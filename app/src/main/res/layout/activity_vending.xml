<?xml version="1.0" encoding="utf-8"?>
<!-- 自販機の画面：左にショーケースと取り出し口、右にお金の表示ともどるボタン -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vending_room"
    tools:context=".VendingActivity">

    <!-- 自販機の本体 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="12dp"
        android:background="@drawable/vending_body"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- 左：ショーケースと取り出し口 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical">

            <!-- ショーケース（商品はJavaで並べる） -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/vending_window"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/slotRow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:padding="6dp" />

                <!-- ガラスに映る光（ななめの帯） -->
                <View
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="70dp"
                    android:background="#16FFFFFF"
                    android:rotation="18"
                    android:scaleY="1.4" />
            </FrameLayout>

            <!-- 取り出し口 -->
            <TextView
                android:id="@+id/txtSlot"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/vending_slot"
                android:gravity="center"
                android:text="@string/vending_slot"
                android:textColor="@color/rpg_gray"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 右：お金の表示ともどるボタン -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtLed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/vending_led"
                android:fontFamily="monospace"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:padding="10dp"
                android:textColor="@color/vending_led_green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- お金を入れる所（かざり） -->
            <TextView
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/vending_slot"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="@string/vending_coin"
                android:textColor="@color/rpg_gray"
                android:textSize="11sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnExit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rpg_window"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="@string/vending_exit"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>


    <!-- 買ったときのポップアップ（ふだんはかくしておく） -->
    <FrameLayout
        android:id="@+id/popup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- 後ろの光 -->
        <View
            android:id="@+id/popGlow"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:background="@drawable/pop_glow" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgPop"
                android:layout_width="wrap_content"
                android:layout_height="170dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null" />

            <!-- 商品名 -->
            <TextView
                android:id="@+id/txtPop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/dotgothic16"
                android:shadowColor="#FF000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="0.01"
                android:textColor="@color/white"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/txtPopSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dotgothic16"
                android:text="@string/vending_pop_sub"
                android:textColor="#FFDCE6F5"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/dotgothic16"
                android:text="@string/vending_pop_tap"
                android:textColor="@color/rpg_gray"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
