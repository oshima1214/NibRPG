<?xml version="1.0" encoding="utf-8"?>
<!-- 戦闘画面（板書うつしバトル）：左に先生、右に黒板とボタン -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/battle_bg"
    tools:context=".MemoryBattleActivity">

    <!-- 上：先生（左）とゲーム（右）、下：先生のひとこと -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- 左：先生 -->
        <LinearLayout
            android:layout_width="190dp"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTeacherName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/rpg_yellow"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ProgressBar
            android:id="@+id/barTeacher"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:progressBackgroundTint="#55FFFFFF"
            android:progressTint="@color/rpg_red"
            android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/txtTeacherHp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/rpg_gray"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/imgTeacher"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginVertical="4dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="@null" />

        </LinearLayout>

        <!-- 右：自分のHP・残り時間・黒板・教科のボタン -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            tools:ignore="RtlSymmetry">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battle_you"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/barPlayer"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:progressBackgroundTint="#55FFFFFF"
                    android:progressTint="@color/battle_hp_green" />

                <TextView
                    android:id="@+id/txtPlayerHp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 残り時間 -->
            <ProgressBar
                android:id="@+id/barTime"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:max="1000"
                android:progressBackgroundTint="#55FFFFFF"
                android:progressTint="@color/rpg_yellow" />

            <!-- 黒板（ここに教科の文字が書かれて、消える） -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@drawable/blackboard"
                android:padding="10dp">

                <TextView
                    android:id="@+id/txtBoard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/dotgothic16"
                    android:gravity="center"
                    android:letterSpacing="0.2"
                    android:textColor="@color/white"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/txtBoardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </FrameLayout>

            <!-- 結果のメッセージ -->
            <TextView
                android:id="@+id/txtMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:minLines="2"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <!-- 教科のボタン（Javaで作る。2段） -->
            <LinearLayout
                android:id="@+id/buttonRow1"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/buttonRow2"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <!-- 持っている道具（Javaで作る） -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/itemRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

        <!-- 先生のひとこと（画面の下に、横いっぱいの大きなウィンドウで） -->
        <TextView
            android:id="@+id/txtLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/rpg_window"
            android:gravity="center_vertical"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ダメージを受けたとき、一瞬赤くするための幕 -->
    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/rpg_red" />

    <!-- 勝ったときの結果 -->
    <LinearLayout
        android:id="@+id/resultBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/rpg_window"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/nib_button"
            android:paddingHorizontal="32dp"
            android:paddingVertical="10dp"
            android:text="@string/battle_to_map"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
