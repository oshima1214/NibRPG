<?xml version="1.0" encoding="utf-8"?>
<!-- 戦闘画面（ことば並べバトル）：左に先生、右に問題と札 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/battle_bg"
    tools:context=".BattleActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- 左：先生 -->
        <LinearLayout
            android:layout_width="190dp"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTeacherName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/rpg_yellow"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ProgressBar
            android:id="@+id/barTeacher"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:progressBackgroundTint="#55FFFFFF"
            android:progressTint="@color/rpg_red"
            android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/txtTeacherHp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/rpg_gray"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/imgTeacher"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginVertical="4dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="@null" />

            <!-- 先生のひとこと -->
            <TextView
                android:id="@+id/txtLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rpg_window"
                android:minLines="2"
                android:padding="8dp"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 右：自分のHP・残り時間・問題・札 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            tools:ignore="RtlSymmetry">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battle_you"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/barPlayer"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:progressBackgroundTint="#55FFFFFF"
                    android:progressTint="@color/battle_hp_green" />

                <TextView
                    android:id="@+id/txtPlayerHp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 残り時間 -->
            <ProgressBar
            android:id="@+id/barTime"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progressBackgroundTint="#55FFFFFF"
            android:progressTint="@color/rpg_yellow"
            android:layout_marginTop="10dp"
            android:max="1000" />

            <!-- ヒント -->
            <TextView
                android:id="@+id/txtHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/nib_cyan"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- 答えの枠（問題ごとにJavaで作る） -->
            <LinearLayout
                android:id="@+id/answerRow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <!-- 結果のメッセージ -->
            <TextView
                android:id="@+id/txtMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minLines="2"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <!-- 文字の札（問題ごとにJavaで作る） -->
            <LinearLayout
                android:id="@+id/tileRow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 下：消すボタンと道具 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                android:id="@+id/btnBackspace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rpg_window"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/battle_backspace"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

                <TextView
                android:id="@+id/btnReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rpg_window"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/battle_reset"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <!-- 持っている道具（Javaで作る） -->
                    <LinearLayout
                        android:id="@+id/itemRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ダメージを受けたとき、一瞬赤くするための幕 -->
    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/rpg_red" />

    <!-- 勝ったときの結果 -->
    <LinearLayout
        android:id="@+id/resultBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/rpg_window"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/nib_button"
            android:paddingHorizontal="32dp"
            android:paddingVertical="10dp"
            android:text="@string/battle_to_map"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
