<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".TitleActivity">

    <!-- 学校のロゴ -->
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="110dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:src="@drawable/nib_logo" />

    <!-- 「RPG」の文字（ロゴと同じ紺色・ななめ・水色の影） -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.15"
        android:shadowColor="@color/nib_cyan"
        android:shadowDx="5"
        android:shadowDy="5"
        android:shadowRadius="1"
        android:text="@string/title_logo"
        android:textColor="@color/nib_navy"
        android:textSize="60sp"
        android:textStyle="bold|italic" />

    <!-- ロゴの3色を使った線（赤・水色・紺） -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="6dp"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <View
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:background="@color/nib_red" />

        <View
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:background="@color/nib_cyan" />

        <View
            android:layout_width="180dp"
            android:layout_height="match_parent"
            android:background="@color/nib_navy" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/title_sub"
        android:textColor="@color/nib_navy"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- ボタン（点滅はTitleActivity.javaで設定） -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- つづきから（遊んでいる途中のときだけ出す） -->
        <TextView
            android:id="@+id/btnContinue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:background="@drawable/nib_button"
            android:paddingHorizontal="28dp"
            android:paddingVertical="12dp"
            android:text="@string/title_continue"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/nib_button"
            android:paddingHorizontal="28dp"
            android:paddingVertical="12dp"
            android:text="@string/title_start"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 見た目を変える（キャラクリ） -->
        <TextView
            android:id="@+id/btnChara"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:background="@drawable/title_sub_button"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:text="@string/title_chara"
            android:textColor="@color/nib_navy"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- デバッグ用：階をえらんで始める（GameState.DEBUG が true のときだけ出す） -->
    <TextView
        android:id="@+id/btnDebug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="6dp"
        android:text="@string/debug_button"
        android:textColor="@color/rpg_gray"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
