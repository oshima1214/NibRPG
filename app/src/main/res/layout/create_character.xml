<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="#192735">

    <!-- タイトル -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="#465E9A"
        android:gravity="center"
        android:text="@string/character"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:ignore="TextSizeCheck" />

    <!-- Javaでタブを追加する場所 -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#273A61"/>

    <!-- 中央 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- 左：キャラクター -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:padding="6dp"
            android:orientation="vertical"
            android:background="#304363"
            tools:ignore="NestedWeights">

            <FrameLayout
                android:id="@+id/previewArea"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#91ADB1"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnDirectionLeft"
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:text="@string/leftLabel"
                    tools:ignore="TextContrastCheck,TouchTargetSizeCheck" />

                <TextView
                    android:id="@+id/txtDirection"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/center"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/btnDirectionRight"
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:text="@string/rightLabel"
                    tools:ignore="TextContrastCheck,TouchTargetSizeCheck" />

            </LinearLayout>
        </LinearLayout>

        <!-- 右：選択中の設定だけ表示 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6"
            android:layout_marginStart="6dp"
            android:padding="8dp"
            android:orientation="vertical"
            android:background="#304363">

            <TextView
                android:id="@+id/txtPanelTitle"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="false"
                tools:ignore="SpeakableTextPresentCheck">

                <LinearLayout
                    android:id="@+id/optionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- 下：共通操作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/backTotitle"
            android:textColor="#FFFFFF"
            android:backgroundTint="#465783"
            tools:ignore="ButtonStyle,VisualLintButtonSize" />

        <Button
            android:id="@+id/btnRandom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/random"
            android:textColor="#FFFFFF"
            android:backgroundTint="#465783"
            tools:ignore="ButtonStyle,VisualLintButtonSize" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/decition"
            android:textColor="#FFFFFF"
            android:backgroundTint="#456BA7"
            tools:ignore="ButtonStyle,VisualLintButtonSize" />
    </LinearLayout>

</LinearLayout>
