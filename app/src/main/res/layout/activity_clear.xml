<?xml version="1.0" encoding="utf-8"?>
<!-- ゲームクリア画面：学校ロゴの色（紺・水色・赤）を使った「卒業証書」風 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".ClearActivity">

    <!-- 上の帯 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:orientation="horizontal">

        <View
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@color/nib_red" />

        <View
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:background="@color/nib_cyan" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/nib_navy" />
    </LinearLayout>

    <!-- まん中：左右2列 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <!-- 左：ロゴと「GAME CLEAR」 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/nib_logo" />

            <TextView
                android:id="@+id/txtClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:shadowColor="@color/nib_cyan"
                android:shadowDx="5"
                android:shadowDy="5"
                android:shadowRadius="1"
                android:text="@string/clear_logo"
                android:textColor="@color/nib_navy"
                android:textSize="40sp"
                android:textStyle="bold|italic" />

            <!-- タイトル画面と同じ3色の線 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:background="@color/nib_red" />

                <View
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:background="@color/nib_cyan" />

                <View
                    android:layout_width="180dp"
                    android:layout_height="match_parent"
                    android:background="@color/nib_navy" />
            </LinearLayout>

            <!-- 先生4人（クリアをお祝いしている） -->
            <LinearLayout
                android:id="@+id/rowTeachers"
                android:layout_width="wrap_content"
                android:layout_height="110dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/s_m_sensei" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/e_sensei" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/s_s_sensei" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:src="@drawable/koutyou_sensei" />
            </LinearLayout>
        </LinearLayout>

        <!-- 右：卒業証書とボタン -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/cardCert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/cert_card"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingVertical="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/clear_cert_title"
                    android:textColor="@color/nib_navy"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/nib_red" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/clear_msg"
                    android:textColor="@color/black"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="end"
                    android:text="@string/clear_sign"
                    android:textColor="@color/nib_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/nib_button"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="40dp"
                android:paddingVertical="10dp"
                android:text="@string/to_endroll"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 下の帯（上の帯と左右を逆にした並び） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/nib_navy" />

        <View
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@color/nib_cyan" />

        <View
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:background="@color/nib_red" />
    </LinearLayout>

</LinearLayout>
